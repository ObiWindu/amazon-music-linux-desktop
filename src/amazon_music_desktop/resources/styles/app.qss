QMainWindow {
    background: #1e1e2e;
}
QToolBar {
    background: #2a2a3c;
    border: none;
    padding: 6px;
    spacing: 6px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e0e0e0;
}
QToolButton:hover {
    background: #3a3a52;
    border: 1px solid #555570;
}
QToolButton:pressed {
    background: #4a4a6a;
}
QToolButton:disabled {
    color: #666680;
}
QProgressBar {
    background: #3a3a52;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
}
QProgressBar::chunk {
    background: #7c6af7;
    border-radius: 4px;
}
QStatusBar {
    background: #2a2a3c;
    color: #aaaacc;
    border-top: 1px solid #3a3a52;
}
QMenuBar {
    background: #2a2a3c;
    color: #e0e0e0;
}
QMenuBar::item:selected {
    background: #3a3a52;
}
QMenu {
    background: #2a2a3c;
    color: #e0e0e0;
    border: 1px solid #3a3a52;
}
QMenu::item:selected {
    background: #7c6af7;
}
QDialog {
    background: #1e1e2e;
    color: #e0e0e0;
}
QLabel {
    color: #e0e0e0;
}
QLineEdit, QComboBox, QSpinBox {
    background: #2a2a3c;
    color: #e0e0e0;
    border: 1px solid #3a3a52;
    border-radius: 4px;
    padding: 4px;
}
QTextEdit {
    background: #2a2a3c;
    color: #e0e0e0;
    border: 1px solid #3a3a52;
    border-radius: 4px;
}
QPushButton {
    background: #7c6af7;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton:hover {
    background: #8d7bf8;
}
QPushButton:pressed {
    background: #6a58e0;
}

/* native player bar (ui/player_bar.py) — purple-blended transport */
QFrame#playerBar {
    background: #211d33;
    border-top: 1px solid #3d365e;
}
QLabel#trackTitle {
    color: #e8e4ff;
    font-size: 13px;
    font-weight: bold;
}
QLabel#seekTick {
    color: #b8aee6;
    font-size: 10px;
}
QSlider#seekSlider {
    background: transparent;
    min-height: 12px;
}
QSlider#seekSlider:horizontal {
    background: transparent;
}
QSlider#seekSlider:horizontal::groove {
    height: 5px;
    border-radius: 2px;
    background: #2e2a47;
    border: 1px solid #3d365e;
}
QSlider#seekSlider:horizontal::sub-page {
    background: #7c6af7;
    border-radius: 2px;
}
QSlider#seekSlider:horizontal::add-page {
    background: #2e2a47;
    border-radius: 2px;
}
QSlider#seekSlider:horizontal::handle {
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
    background: #e8e4ff;
    border: 1px solid #7c6af7;
}
QSlider#seekSlider:horizontal::handle:hover {
    background: #ffffff;
    border: 1px solid #9a86ff;
}
QSlider#seekSlider:disabled::sub-page {
    background: #4a4468;
}
QSlider#volSlider {
    background: transparent;
    min-height: 12px;
}
QSlider#volSlider:horizontal::groove {
    height: 4px;
    border-radius: 2px;
    background: #2e2a47;
    border: 1px solid #3d365e;
}
QSlider#volSlider:horizontal::sub-page {
    background: #7c6af7;
    border-radius: 2px;
}
QSlider#volSlider:horizontal::add-page {
    background: #2e2a47;
    border-radius: 2px;
}
QSlider#volSlider:horizontal::handle {
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 5px;
    background: #e8e4ff;
    border: 1px solid #7c6af7;
}
QSlider#volSlider:horizontal::handle:hover {
    background: #ffffff;
    border: 1px solid #9a86ff;
}

/* queue panel (ui/queue_panel.py) — same purple family as the player bar */
QFrame#queuePanel {
    background: #211d33;
    border-left: 1px solid #3d365e;
}
QLabel#queueHeader {
    color: #c4b5fd;
    font-size: 16px;
    font-weight: bold;
}
QLabel#queueNote {
    color: #b8aee6;
    font-size: 11px;
}
QListWidget#queueList {
    background: #221d38;
    color: #e8e4ff;
    border: none;
    outline: none;
}
QListWidget#queueList::item {
    padding: 4px 6px;
    border-radius: 4px;
}
QListWidget#queueList::item:hover {
    background: #2e2847;
}
