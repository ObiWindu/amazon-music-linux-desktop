QMainWindow {
    background: #1c1830;
}
QToolBar {
    background: #251f3d;
    border: none;
    padding: 6px;
    spacing: 6px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e8e4ff;
}
QToolButton:hover {
    background: #2e2847;
    border: 1px solid #3d365e;
}
QToolButton:pressed {
    background: #3b3363;
}
QToolButton:disabled {
    color: #6b6390;
}
QProgressBar {
    background: #2e2847;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
}
QProgressBar::chunk {
    background: #7c6af7;
    border-radius: 4px;
}
QStatusBar {
    background: #211d33;
    color: #b8aee6;
    border-top: 1px solid #3d365e;
}
QMenuBar {
    background: #211d33;
    color: #e8e4ff;
}
QMenuBar::item:selected {
    background: #2e2847;
}
QMenu {
    background: #251f3d;
    color: #e8e4ff;
    border: 1px solid #3d365e;
}
QMenu::item:selected {
    background: #7c6af7;
}
QDialog {
    background: #1c1830;
    color: #e8e4ff;
}
QLabel {
    color: #e8e4ff;
}
QLineEdit, QComboBox, QSpinBox {
    background: #251f3d;
    color: #e8e4ff;
    border: 1px solid #3d365e;
    border-radius: 4px;
    padding: 4px;
}
QTextEdit {
    background: #251f3d;
    color: #e8e4ff;
    border: 1px solid #3d365e;
    border-radius: 4px;
}
QPushButton {
    background: #7c6af7;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton:hover {
    background: #8d7bf8;
}
QPushButton:pressed {
    background: #6a58e0;
}

/* native player bar (ui/player_bar.py) — purple-blended transport */
QFrame#playerBar {
    background: #211d33;
    border-top: 1px solid #3d365e;
}
QLabel#trackTitle {
    color: #e8e4ff;
    font-size: 13px;
    font-weight: bold;
}
QLabel#seekTick {
    color: #b8aee6;
    font-size: 10px;
}
/* seek/vol sliders are painted in code by ui/player_bar.py (ThemedSlider):
   QSS ::sub-page does not fill the progress side reliably across styles */
QSlider#seekSlider, QSlider#volSlider {
    background: transparent;
}

/* queue panel (ui/queue_panel.py) — same purple family as the player bar */
QFrame#queuePanel {
    background: #211d33;
    border-left: 1px solid #3d365e;
}
QLabel#queueHeader {
    color: #c4b5fd;
    font-size: 16px;
    font-weight: bold;
}
QLabel#queueNote {
    color: #b8aee6;
    font-size: 11px;
}
QListWidget#queueList {
    background: #221d38;
    color: #e8e4ff;
    border: none;
    outline: none;
}
QListWidget#queueList::item {
    padding: 4px 6px;
    border-radius: 4px;
}
QListWidget#queueList::item:hover {
    background: #2e2847;
}

/* sidebar playlist list (main_window.py) — same purple family */
QListWidget#playlistList {
    background: #221d38;
    color: #e8e4ff;
    border: none;
    outline: none;
    border-radius: 6px;
    font-size: 12px;
}
QListWidget#playlistList::item {
    padding: 4px 6px;
    border-radius: 4px;
}
QListWidget#playlistList::item:hover {
    background: #2e2847;
}
QListWidget#playlistList::item:selected {
    background: #7c6af7;
    color: #ffffff;
}
